<UserControl x:Class="X4Calculator.UI.Views.StarMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:X4Calculator.Core.Data;assembly=X4Calculator.Core"
             xmlns:local="clr-namespace:X4Calculator.UI.Views"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="600">
    <Grid x:Name="RootGrid" Background="{StaticResource MapBackgroundBrush}" ClipToBounds="True">
        <!--
          世界坐标画布：六边形 / 星门 / 门连线 / 扇区名称都使用银河系星图显示坐标，
          整体通过 RenderTransform（缩放+平移）映射到屏幕——如同一张图片，缩放时所有元素（含名称）一起缩放。
        -->
        <Canvas x:Name="WorldCanvas">
            <!-- 由代码动态填充 -->
        </Canvas>

        <!-- 屏幕空间运输层：线宽与微小箭头不随星图缩放改变。 -->
        <local:TransportFlowOverlay x:Name="TransportOverlay"
                                    OutgoingBrush="{StaticResource AccentGreenBrush}"
                                    IncomingBrush="{StaticResource AccentRedBrush}"/>

        <Canvas x:Name="TransportHoverCanvas" IsHitTestVisible="False">
            <Border x:Name="OutgoingHoverBorder" Visibility="Collapsed"
                    Background="{StaticResource MapOverlayBrush}"
                    BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1.25"
                    CornerRadius="4" Padding="10 7" MaxWidth="280"
                    AutomationProperties.AutomationId="starmap.transport.hover.outgoing">
                <StackPanel>
                    <TextBlock Text="运出货物" Foreground="{StaticResource AccentGreenBrush}"
                               FontWeight="Bold" Margin="0 0 0 3"/>
                    <TextBlock x:Name="OutgoingHoverText" Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border x:Name="IncomingHoverBorder" Visibility="Collapsed"
                    Background="{StaticResource MapOverlayBrush}"
                    BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="1.25"
                    CornerRadius="4" Padding="10 7" MaxWidth="280"
                    AutomationProperties.AutomationId="starmap.transport.hover.incoming">
                <StackPanel>
                    <TextBlock Text="运入货物" Foreground="{StaticResource AccentRedBrush}"
                               FontWeight="Bold" Margin="0 0 0 3"/>
                    <TextBlock x:Name="IncomingHoverText" Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- 放置预览位于屏幕空间，始终保持 22 DIP 且不截获地图点击。 -->
        <Canvas x:Name="PlacementPreviewCanvas" IsHitTestVisible="False" Visibility="Collapsed"/>

        <!-- 顶部提示 -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="10" Padding="10 6" CornerRadius="6"
                Background="{StaticResource MapOverlayBrush}">
            <TextBlock x:Name="HintText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                       Text="点击空间站查看运输 · 滚轮缩放 · 拖拽平移 · 双击复位"/>
        </Border>

        <!-- 缩放百分比 -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="12" Padding="10 6" CornerRadius="6"
                Background="{StaticResource MapOverlayBrush}">
            <TextBlock x:Name="ZoomText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Text="100%"/>
        </Border>

        <!-- 站点显示模式与 NPC 高亮 -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="10">
            <Border x:Name="NpcHighlightPanel" Visibility="Collapsed" Margin="0 0 8 0"
                    Padding="10 4" CornerRadius="6" Background="{StaticResource Surface0Brush}"
                    AutomationProperties.AutomationId="starmap.npc-highlight-panel">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="高亮" Margin="0 0 8 0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <ComboBox x:Name="NpcHighlightComboBox" Width="148" SelectedIndex="0"
                              Style="{StaticResource DarkComboBox}"
                              SelectionChanged="OnNpcHighlightSelectionChanged"
                              AutomationProperties.AutomationId="starmap.npc-highlight">
                        <ComboBoxItem Content="无"/>
                        <ComboBoxItem Content="黑市商人"/>
                        <ComboBoxItem Content="Kha'ak 空间站"/>
                        <ComboBoxItem Content="无主舰船"/>
                        <ComboBoxItem Content="数据保险库"/>
                        <ComboBoxItem Content="妖王数据保险库"/>
                        <ComboBoxItem Content="信仰之跃异常点"/>
                    </ComboBox>
                </StackPanel>
            </Border>
            <Border CornerRadius="6" Background="{StaticResource Surface0Brush}">
                <Button x:Name="StationModeToggleButton" Content="切换为NPC站点显示"
                        Padding="12 6" Click="OnStationModeToggleClick"
                        Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                        FontSize="12" AutomationProperties.AutomationId="starmap.station-mode-toggle">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Surface1Brush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
