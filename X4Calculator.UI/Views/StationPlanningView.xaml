<UserControl x:Class="X4Calculator.UI.Views.StationPlanningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:X4Calculator.UI.ViewModels"
             xmlns:views="clr-namespace:X4Calculator.UI.Views"
             xmlns:converters="clr-namespace:X4Calculator.UI.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter"/>
        <converters:StationIconKeyToImageSourceConverter x:Key="StationIconKeyToImageSourceConverter"/>
        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0 0 0 2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}"/>
        <Style x:Key="StationHeaderTextBox" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
        <Style x:Key="StationHeaderComboBox" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
            <Setter Property="Height" Value="35"/>
        </Style>
        <Style x:Key="StationHeaderValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PlanningListBox" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource BgBaseBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style x:Key="PlanningListBoxItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlanningCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10 5"/>
            <Setter Property="Margin" Value="0 0 0 3"/>
        </Style>
        <DataTemplate x:Key="CapacityProductTemplate">
            <Border Style="{StaticResource PlanningCard}">
                <StackPanel>
                    <Button Command="{Binding DataContext.ToggleCapacityItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" Background="Transparent" Padding="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Role}" Value="Intermediate"><Setter Property="Fill" Value="{StaticResource AccentYellowBrush}"/></DataTrigger><DataTrigger Binding="{Binding Role}" Value="Terminal"><Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12 0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayBuiltAmount}" FontSize="16" FontWeight="Bold">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsPositive}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasPlannedCapacity, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="（" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding DisplayTotalAmount}" FontSize="16" FontWeight="Bold">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsTotalPositive}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="）" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DisplayUnit}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding ExpandGlyph}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Sources}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}" Margin="22 3 0 0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="4" Padding="8 3" Margin="0 0 0 2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Role}" Value="Intermediate"><Setter Property="Fill" Value="{StaticResource AccentYellowBrush}"/></DataTrigger><DataTrigger Binding="{Binding Role}" Value="Terminal"><Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                        </Ellipse>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            <TextBlock Grid.Column="1" Text="（规划）" Margin="2 0 0 0"
                                                       Foreground="{StaticResource ThroughputBlueBrush}"
                                                       Visibility="{Binding IsPlanned, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       AutomationProperties.AutomationId="station-planning.capacity-planned-marker"/>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayAmount}" FontWeight="SemiBold" Margin="12 0 0 0">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsPositive}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="StationPlanningModuleTemplate">
            <Border Style="{StaticResource PlanningCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Visibility="{Binding HasRole, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Role}" Value="Intermediate"><Setter Property="Fill" Value="{StaticResource AccentYellowBrush}"/></DataTrigger><DataTrigger Binding="{Binding Role}" Value="Terminal"><Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                    </Ellipse>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ProductFilters}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedProductFilter, Mode=TwoWay}" Style="{StaticResource DarkComboBox}"
                              Width="118" Margin="0 0 8 0" Visibility="{Binding HasProductFilter, Converter={StaticResource BoolToVisibilityConverter}}"
                              AutomationProperties.AutomationId="station-planning.product-filter"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding OperatingModeFilters}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedOperatingMode, Mode=TwoWay}" Style="{StaticResource DarkComboBox}"
                              Width="118" Margin="0 0 8 0" Visibility="{Binding HasOperatingModeFilter, Converter={StaticResource BoolToVisibilityConverter}}"
                              AutomationProperties.AutomationId="station-planning.operating-mode-filter"/>
                    <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        <TextBlock Grid.Column="1" Text="（自动添加）" Foreground="{StaticResource AccentPeachBrush}" FontWeight="ExtraBold" FontSize="15" Margin="6 0 0 0" VerticalAlignment="Center"
                                   Visibility="{Binding IsAutoAdded, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.AutomationId="station-planning.auto-added-label"/>
                    </Grid>
                    <TextBlock Grid.Column="3" Text="{Binding WorkforceBonusText}" Margin="8 0 0 0" FontWeight="ExtraBold" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center"
                               Visibility="{Binding HasWorkforceBonus, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.AutomationId="station-planning.workforce-bonus"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12 0" VerticalAlignment="Center">
                        <TextBlock Text="×" Margin="0 0 5 0" FontWeight="SemiBold" Foreground="{StaticResource ThroughputBlueBrush}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding ModuleCountText, Mode=TwoWay, UpdateSourceTrigger=Explicit}" Width="56" Padding="5 1"
                                 HorizontalContentAlignment="Center" PreviewTextInput="IntegerTextBox_OnPreviewTextInput"
                                 DataObject.Pasting="IntegerTextBox_OnPasting" LostFocus="ModuleCountTextBox_OnLostFocus"
                                 PreviewKeyDown="ModuleCountTextBox_OnPreviewKeyDown"
                                 PreviewMouseWheel="ModuleCountTextBox_OnPreviewMouseWheel"
                                 AutomationProperties.AutomationId="station-planning.module-count"
                                 ToolTip="输入模块总数；悬停时可用滚轮增减"/>
                        <TextBlock Text="{Binding UnbuiltAmountText}" Margin="4 0 0 0" FontWeight="SemiBold"
                                   Foreground="{StaticResource ThroughputBlueBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="5" Content="×" Command="{Binding DataContext.RemoveModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="StationWareTemplate">
            <Border Background="{StaticResource CardSurfaceBrush}" BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1" CornerRadius="5" Margin="0 0 0 4">
                <StackPanel>
                    <Button Command="{Binding ToggleExpandedCommand}" Background="Transparent" Padding="12 4.5" Margin="0 1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="station-planning.storage-ware-toggle">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Ellipse Width="10" Height="10" Margin="0 0 9 0" VerticalAlignment="Center">
                                <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Role}" Value="Intermediate"><Setter Property="Fill" Value="{StaticResource AccentYellowBrush}"/></DataTrigger><DataTrigger Binding="{Binding Role}" Value="Terminal"><Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="（空间站补给）" Foreground="{StaticResource ThroughputBlueBrush}" FontSize="16" FontWeight="SemiBold"
                                           Visibility="{Binding IsStationSupply, Converter={StaticResource BoolToVisibilityConverter}}"
                                           AutomationProperties.AutomationId="station-planning.station-supply-marker"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding ExpandGlyph}" Foreground="{StaticResource TextSecondaryBrush}" Margin="12 0 0 0"/>
                        </Grid>
                    </Button>
                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}" Margin="12 0 12 6">
                        <StackPanel Visibility="{Binding IsStationSupply, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Grid Margin="0 1.5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="当前数量 / 数量上限" Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.AutomationId="station-planning.storage-quantity-label"/><TextBlock Grid.Column="1" Text="{Binding StorageText}" Foreground="{StaticResource ThroughputBlueBrush}" FontWeight="Bold" ToolTip="{Binding StorageCapacityExplanation}" AutomationProperties.AutomationId="station-planning.storage-quantity"/></Grid>
                        <CheckBox Content="自动分配仓储" IsChecked="{Binding IsAutomaticAllocation, Mode=TwoWay}" Style="{StaticResource DarkCheckBox}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0 2.5"/>
                        <StackPanel Visibility="{Binding IsBuyOfferEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="购买数量" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0 4 0 1.5"/>
                            <CheckBox Content="自动购买量" IsChecked="{Binding IsAutomaticBuyAmount, Mode=TwoWay}" Visibility="{Binding CanUseAutomaticBuyAmount, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource DarkCheckBox}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0 1.5"/>
                            <TextBox Text="{Binding BuyAmountText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEditBuyAmount}" Style="{StaticResource DarkTextBox}" FontSize="16" Margin="0 1 0 2.5"/>
                            <CheckBox Content="自动定价" IsChecked="{Binding IsAutomaticBuyPrice, Mode=TwoWay}" Style="{StaticResource DarkCheckBox}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0 1.5"/>
                            <TextBox Text="{Binding BuyPriceText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEditBuyPrice}" Style="{StaticResource DarkTextBox}" FontSize="16" Margin="0 1 0 0" ToolTip="{Binding AutomaticPriceText}"/>
                            <CheckBox Content="贸易规则使用空间站设置" IsChecked="{Binding UseStationTradeRule, Mode=TwoWay}" Style="{StaticResource DarkCheckBox}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0 4 0 1.5"/>
                            <ComboBox ItemsSource="{Binding TradeRuleOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedTradeRuleId, Mode=TwoWay}" IsEnabled="{Binding CanSelectTradeRule}" Style="{StaticResource DarkComboBox}"/>
                        </StackPanel>
                        <Button Content="{Binding BuyOfferButtonText}" Command="{Binding ToggleBuyOfferCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0 4.5 0 2" AutomationProperties.AutomationId="station-planning.storage-buy-offer-toggle"/>
                        <TextBlock Text="出售数量" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0 6 0 0"/>
                        <StackPanel Visibility="{Binding IsSellOfferEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <CheckBox Content="自动出售量" IsChecked="{Binding IsAutomaticSellAmount, Mode=TwoWay}" Visibility="{Binding CanUseAutomaticSellAmount, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource DarkCheckBox}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0 2.5 0 1.5"/>
                            <TextBox Text="{Binding SellAmountText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEditSellAmount}" Style="{StaticResource DarkTextBox}" FontSize="16" Margin="0 1 0 2.5"/>
                            <CheckBox Content="自动定价" IsChecked="{Binding IsAutomaticSellPrice, Mode=TwoWay}" Style="{StaticResource DarkCheckBox}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0 1.5"/>
                            <TextBox Text="{Binding SellPriceText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEditSellPrice}" Style="{StaticResource DarkTextBox}" FontSize="16" Margin="0 1 0 0" ToolTip="{Binding AutomaticSellPriceText}"/>
                            <CheckBox Content="贸易规则使用空间站设置" IsChecked="{Binding UseStationSellTradeRule, Mode=TwoWay}" Style="{StaticResource DarkCheckBox}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0 4 0 1.5"/>
                            <ComboBox ItemsSource="{Binding TradeRuleOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedSellTradeRuleId, Mode=TwoWay}" IsEnabled="{Binding CanSelectSellTradeRule}" Style="{StaticResource DarkComboBox}"/>
                        </StackPanel>
                        <Button Content="{Binding SellOfferButtonText}" Command="{Binding ToggleSellOfferCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0 4.5 0 2" AutomationProperties.AutomationId="station-planning.storage-sell-offer-toggle"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsStationSupply, Converter={StaticResource BoolToVisibilityConverter}}">
                            <CheckBox Content="自动定价" IsChecked="True" IsEnabled="False" Style="{StaticResource DarkCheckBox}"
                                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0 1.5"
                                      AutomationProperties.AutomationId="station-planning.station-supply-auto-price"/>
                            <TextBox Text="{Binding BuyPriceText}" IsEnabled="False" Style="{StaticResource DarkTextBox}" FontSize="16"
                                     Margin="0 1 0 0" ToolTip="{Binding AutomaticPriceText}"
                                     AutomationProperties.AutomationId="station-planning.station-supply-price"/>
                            <CheckBox Content="贸易规则使用空间站设置" IsChecked="{Binding UseStationTradeRule, Mode=TwoWay}"
                                      Style="{StaticResource DarkCheckBox}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0 4 0 1.5"
                                      AutomationProperties.AutomationId="station-planning.station-supply-use-station-trade-rule"/>
                            <ComboBox ItemsSource="{Binding TradeRuleOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedTradeRuleId, Mode=TwoWay}" IsEnabled="{Binding CanSelectTradeRule}"
                                      Style="{StaticResource DarkComboBox}"
                                      AutomationProperties.AutomationId="station-planning.station-supply-trade-rule"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TransportGroupTemplate">
            <Border Style="{StaticResource PlanningCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Style="{StaticResource DarkCheckBox}" Foreground="{StaticResource TextPrimaryBrush}"
                                  VerticalAlignment="Center" AutomationProperties.AutomationId="station-planning.transport-group-selection"/>
                        <Ellipse Grid.Column="1" Width="9" Height="9" VerticalAlignment="Center"
                                 Visibility="{Binding HasRole, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Role}" Value="Intermediate"><Setter Property="Fill" Value="{StaticResource AccentYellowBrush}"/></DataTrigger><DataTrigger Binding="{Binding Role}" Value="Terminal"><Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                        </Ellipse>
                        <Button Grid.Column="2" Grid.ColumnSpan="3" Command="{Binding ToggleExpandedCommand}" Background="Transparent" Padding="0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="station-planning.transport-group-toggle">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding EfficiencyText}" Margin="8 0"
                                           Foreground="{StaticResource ThroughputBlueBrush}" VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="station-planning.transport-group-efficiency"/>
                                <TextBlock Grid.Column="2" Text="{Binding ExpandGlyph}" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Entries}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Margin="18 4 0 0" AutomationProperties.AutomationId="station-planning.transport-entry-list">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0 0 0 2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource DarkCheckBox}"
                                              Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                              AutomationProperties.AutomationId="station-planning.transport-entry-selection"/>
                                    <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center"
                                             Visibility="{Binding HasRole, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Role}" Value="Intermediate"><Setter Property="Fill" Value="{StaticResource AccentYellowBrush}"/></DataTrigger><DataTrigger Binding="{Binding Role}" Value="Terminal"><Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding EfficiencyText}" Margin="8 0 0 0"
                                               VerticalAlignment="Center" AutomationProperties.AutomationId="station-planning.transport-entry-efficiency">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource ThroughputBlueBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasEfficiencyError}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{StaticResource BgSurfaceBrush}" AutomationProperties.AutomationId="station-planning.root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" MinWidth="300"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="520"/>
        </Grid.ColumnDefinitions>
        <Border Padding="10" BorderBrush="{StaticResource Surface1Brush}" BorderThickness="0 0 1 0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{Binding IsImportedStationsExpanded, Converter={StaticResource BoolToGridLengthConverter}}"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{Binding IsPlannedStationsExpanded, Converter={StaticResource BoolToGridLengthConverter}}"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Content="总览" Command="{Binding SelectOverviewCommand}" FontWeight="Bold" Margin="0 0 0 8"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                <Button Grid.Row="1" Command="{Binding ToggleImportedStationsCommand}" Background="Transparent" Padding="4 2" HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="station-planning.imported-toggle">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="已导入的空间站" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ImportedStationsToggleGlyph}" Foreground="{StaticResource TextSecondaryBrush}" Margin="8 0 0 0"/>
                    </Grid>
                </Button>
                <ListBox x:Name="ImportedStationList" Grid.Row="2" ItemsSource="{Binding ImportedStations}" Style="{StaticResource PlanningListBox}" Padding="0"
                         ItemContainerStyle="{StaticResource PlanningListBoxItem}" AutomationProperties.AutomationId="station-planning.imported-list">
                    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="{Binding DeleteButtonText}" Command="{Binding DataContext.DeleteStationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Center" Padding="7 5" Margin="0 0 4 4" AutomationProperties.AutomationId="station-planning.delete"/><Button Grid.Column="1" Command="{Binding DataContext.SelectStationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Width="18" Height="18" Source="{Binding IconKey, Converter={StaticResource StationIconKeyToImageSourceConverter}}" Stretch="Uniform" Margin="0 0 4 0"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></Grid></Button></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
