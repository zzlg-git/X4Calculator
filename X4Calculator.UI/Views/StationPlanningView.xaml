                        <TextBlock Text="劳动力增长时间" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" AutomationProperties.AutomationId="station-planning.workforce-growth-title"/>
                        <TextBlock Text="每周期增长人数" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 10 0 0"/>
                        <TextBlock Text="{Binding WorkforceGrowthPerCycleText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" AutomationProperties.AutomationId="station-planning.workforce-growth-per-cycle"/>
                        <TextBlock Text="距下次增长的时间" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 8 0 0"/>
                        <TextBlock Text="{Binding WorkforceNextGrowthTimeText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" AutomationProperties.AutomationId="station-planning.workforce-next-growth-time"/>
                        <TextBlock Text="增长到目标的时间" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 8 0 0"/>
                        <TextBlock Text="{Binding WorkforceGrowthTimeText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" AutomationProperties.AutomationId="station-planning.workforce-growth-time"/>
                        <TextBlock Text="加成" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0 14 0 4"/>
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <Grid Visibility="{Binding AreStandardWorkforceGrowthInfluencesVisible, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.AutomationId="station-planning.standard-workforce-growth-influences"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" SharedSizeGroup="WorkforceGrowthInfluenceValue"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="基础增长" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding WorkforceBaseGrowthText}" Foreground="{StaticResource AccentGreenBrush}"/>
                                <TextBlock Grid.Row="1" Text="星区人口" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WorkforcePopulationBonusText}" Foreground="{StaticResource AccentGreenBrush}"/>
                                <TextBlock Grid.Row="2" Text="大型居住地" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WorkforceCapacityBonusText}" Foreground="{StaticResource AccentGreenBrush}"/>
                                <TextBlock Grid.Row="3" Text="工人福利" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WorkforceWelfareBonusText}" Foreground="{StaticResource AccentGreenBrush}"/>
                            </Grid>
                            <Grid AutomationProperties.AutomationId="station-planning.workforce-growth-constraint"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" SharedSizeGroup="WorkforceGrowthInfluenceValue"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding WorkforceGrowthConstraintLabel}" Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.AutomationId="station-planning.workforce-growth-constraint-label"/>
                                <TextBlock Grid.Column="1" Text="{Binding WorkforceGrowthConstraintText}" Foreground="{StaticResource AccentRedBrush}" AutomationProperties.AutomationId="station-planning.workforce-growth-constraint-value"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="劳动力增长计算假定补给充足，模块完整。接近上限时曲线为实测线性拟合，可能不准确。" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0 14 0 0" AutomationProperties.AutomationId="station-planning.workforce-growth-assumption"/>
                        <Grid Margin="0 8 0 0" Visibility="{Binding HasWorkforceShiftTime, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.AutomationId="station-planning.workforce-shift-row">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="下一班的时间" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding WorkforceShiftTimeText}" Foreground="{StaticResource AccentGreenBrush}" FontSize="16" FontWeight="Bold" AutomationProperties.AutomationId="station-planning.workforce-shift-time"/>
                        </Grid>
                      </StackPanel>
                      </ScrollViewer>
                    </Border>
                </Grid>
                <Grid Grid.Row="1" Margin="0 14 0 0" Visibility="{Binding IsStorageEconomyView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="0 0 0 8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="仓储视图" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="station-planning.storage-title"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableTradeWareOptions}" DisplayMemberPath="Name" SelectedValuePath="WareId"
                                      SelectedValue="{Binding SelectedTradeWareId, Mode=TwoWay}" Style="{StaticResource DarkComboBox}" Margin="6 0"
                                      AutomationProperties.AutomationId="station-planning.trade-ware-filter"/>
                            <Button Grid.Column="2" Content="新增贸易货物" Command="{Binding AddTradeWareCommand}" HorizontalContentAlignment="Center"
                                    FontSize="13" Padding="6 5"
                                    AutomationProperties.AutomationId="station-planning.add-trade-ware"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding StorageFillDrainTimeText}" Margin="0 0 0 8"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" VerticalAlignment="Center"
                                   Visibility="{Binding IsStorageFillDrainTimeVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                   AutomationProperties.AutomationId="station-planning.storage-fill-drain-time"/>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="station-planning.storage-list">
                            <ItemsControl ItemsSource="{Binding StorageWareItems}" ItemTemplate="{StaticResource StationWareTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="0 0 0 8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="运输视图" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           AutomationProperties.AutomationId="station-planning.transport-title"/>
                                <TextBlock Text="{Binding TransportEfficiencyText}" Margin="10 0 0 0" FontSize="16"
                                           Foreground="{StaticResource ThroughputBlueBrush}" VerticalAlignment="Center"
                                           Visibility="{Binding HasTransportContent, Converter={StaticResource BoolToVisibilityConverter}}"
                                           AutomationProperties.AutomationId="station-planning.transport-total-efficiency"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{Binding TransportShipSizeToggleText}" Command="{Binding ToggleTransportShipSizeCommand}"
                                    Style="{StaticResource ActionButton}" Padding="8 3" FontSize="12"
                                    Margin="10 0 0 0"
                                    Visibility="{Binding HasTransportContent, Converter={StaticResource BoolToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="station-planning.transport-ship-size-toggle"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TransportStatusText}" TextWrapping="Wrap"
                                   Margin="0 0 0 8" Visibility="{Binding HasTransportStatus, Converter={StaticResource BoolToVisibilityConverter}}"
                                   AutomationProperties.AutomationId="station-planning.transport-status">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedStationItem.IsPlanned}" Value="True"/>
                                                <Condition Binding="{Binding SelectedStationItem.HasMapPlacement}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="FontSize" Value="18"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.AutomationId="station-planning.transport-sections-scroll">
                        <Grid Visibility="{Binding HasTransportContent, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button Command="{Binding ToggleIncomingTransportCommand}" Background="Transparent" Padding="0" Margin="0 0 6 0"
                                            HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="station-planning.transport-incoming-toggle">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="运入本空间站" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" AutomationProperties.AutomationId="station-planning.transport-incoming-title"/>
                                            <TextBlock Grid.Column="1" Text="{Binding IncomingTransportToggleGlyph}" Margin="12 0 0 0"
                                                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                                                       AutomationProperties.AutomationId="station-planning.transport-incoming-toggle-glyph"/>
                                        </Grid>
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="{Binding IncomingTransportEfficiencyText}" Margin="8 0"
                                               Foreground="{StaticResource ThroughputBlueBrush}" VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="station-planning.transport-incoming-efficiency"/>
                                    <CheckBox Grid.Column="2" Content="按货物分类" IsChecked="{Binding IsIncomingGroupedByWare, Mode=TwoWay}"
                                              Style="{StaticResource DarkCheckBox}" Foreground="{StaticResource TextPrimaryBrush}"
                                              AutomationProperties.AutomationId="station-planning.transport-incoming-group-by-ware"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0 4 0 0" Visibility="{Binding IsIncomingTransportExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ScrollViewer Visibility="{Binding IsIncomingGroupedByWare, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                                  AutomationProperties.AutomationId="station-planning.transport-incoming-ware-list">
                                        <ItemsControl ItemsSource="{Binding IncomingTransportWareGroups}" ItemTemplate="{StaticResource TransportGroupTemplate}"/>
                                    </ScrollViewer>
                                    <ScrollViewer Visibility="{Binding IsIncomingGroupedByWare, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                  VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                                  AutomationProperties.AutomationId="station-planning.transport-incoming-station-list">
                                        <ItemsControl ItemsSource="{Binding IncomingTransportStationGroups}" ItemTemplate="{StaticResource TransportGroupTemplate}"/>
                                    </ScrollViewer>
                                </Grid>
                            <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button Command="{Binding ToggleOutgoingTransportCommand}" Background="Transparent" Padding="0" Margin="0 0 6 0"
                                            HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="station-planning.transport-outgoing-toggle">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="本空间站运出" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" AutomationProperties.AutomationId="station-planning.transport-outgoing-title"/>
                                            <TextBlock Grid.Column="1" Text="{Binding OutgoingTransportToggleGlyph}" Margin="12 0 0 0"
                                                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                                                       AutomationProperties.AutomationId="station-planning.transport-outgoing-toggle-glyph"/>
                                        </Grid>
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="{Binding OutgoingTransportEfficiencyText}" Margin="8 0"
                                               Foreground="{StaticResource ThroughputBlueBrush}" VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="station-planning.transport-outgoing-efficiency"/>
                                    <CheckBox Grid.Column="2" Content="按货物分类" IsChecked="{Binding IsOutgoingGroupedByWare, Mode=TwoWay}"
                                              Style="{StaticResource DarkCheckBox}" Foreground="{StaticResource TextPrimaryBrush}"
                                              AutomationProperties.AutomationId="station-planning.transport-outgoing-group-by-ware"/>
                                </Grid>
                                <Grid Grid.Row="3" Margin="0 4 0 0" Visibility="{Binding IsOutgoingTransportExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ScrollViewer Visibility="{Binding IsOutgoingGroupedByWare, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                                  AutomationProperties.AutomationId="station-planning.transport-outgoing-ware-list">
                                        <ItemsControl ItemsSource="{Binding OutgoingTransportWareGroups}" ItemTemplate="{StaticResource TransportGroupTemplate}"/>
                                    </ScrollViewer>
                                    <ScrollViewer Visibility="{Binding IsOutgoingGroupedByWare, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                  VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                                  AutomationProperties.AutomationId="station-planning.transport-outgoing-station-list">
                                        <ItemsControl ItemsSource="{Binding OutgoingTransportStationGroups}" ItemTemplate="{StaticResource TransportGroupTemplate}"/>
                                    </ScrollViewer>
                                </Grid>
                        </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
