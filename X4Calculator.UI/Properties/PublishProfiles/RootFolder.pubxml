<?xml version="1.0" encoding="utf-8"?>
<!--
    发布配置：将 X4Calculator.UI 发布到项目根目录下的 X4Calculator.App 文件夹
    （仓库根目录的 X4Calculator.App\）。
    依赖框架 + 单文件：不打包 .NET 运行时，目标机器需要安装 .NET 8 Desktop Runtime (x64)。

    用法：
      dotnet publish X4Calculator.UI\X4Calculator.UI.csproj -p:PublishProfile=RootFolder
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\X4Calculator.App\</PublishDir>
    <!-- GameData 是用户在首次运行时生成的持久数据；重复发布不得清空输出目录。 -->
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- 发布完成后删除输出目录中的 .pdb（依赖项目如 Core 仍会生成，这里统一清理，保持发布产物干净） -->
  <Target Name="RemovePdbFromPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <_PublishPdbFiles Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishPdbFiles)" />
  </Target>
</Project>
